# Application Configuration
DEBUG=True
APP_NAME=Soft Collar Toolbox 2.0
APP_VERSION=0.1.0

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Configuration
# Comma-separated list of allowed origins
# Use * for all origins (development only)
CORS_ORIGINS=http://localhost:3000,http://localhost:8888

# File Upload Configuration
MAX_FILE_SIZE=52428800  # 50MB in bytes
ALLOWED_IMAGE_FORMATS=jpg,jpeg,png,webp,gif,bmp
ALLOWED_PDF_FORMATS=pdf
ALLOWED_TEXT_FORMATS=txt,md,json,csv

# Database Configuration (for future use)
# DATABASE_URL=sqlite:///./toolbox.db

# Redis Configuration (for future use)
# REDIS_URL=redis://localhost:6379/0

# API Keys (for future AI features)
# OPENAI_API_KEY=your_openai_api_key_here
# STABILITY_API_KEY=your_stability_api_key_here

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=app.log

# Security Configuration
SECRET_KEY=your_secret_key_here_change_in_production
ALGORITHM=HS256

# Feature Flags
ENABLE_AI_FEATURES=False
ENABLE_YOUTUBE_SEARCH=False
