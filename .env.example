# Soft Collar Toolbox 2.0 - Environment Variables
# Copy this file to .env and update values as needed

# ==================== General Settings ====================
# Application name and version
APP_NAME=Soft Collar Toolbox 2.0
APP_VERSION=2.0.0

# ==================== Port Configuration ====================
# Nginx port (external access)
NGINX_PORT=8888

# ==================== Frontend Settings ====================
# Next.js API URL (used by frontend to call backend)
# For production: http://your-nas-ip:8888/api
# For development: http://localhost:8888/api
NEXT_PUBLIC_API_URL=http://localhost:8888/api

# ==================== Backend Settings ====================
# Debug mode (True for development, False for production)
DEBUG=False

# CORS origins (comma-separated list)
# Add your NAS IP or domain here
CORS_ORIGINS=http://localhost:8888,http://127.0.0.1:8888

# ==================== Synology NAS Specific ====================
# If deploying on Synology NAS, set these:
# NAS_IP=192.168.1.100
# NGINX_PORT=8888

# For external access via Synology reverse proxy:
# NEXT_PUBLIC_API_URL=https://yourdomain.com/toolbox/api
# CORS_ORIGINS=https://yourdomain.com

# ==================== YouTube API Settings ====================
# YouTube Data API v3 Keys (required for KOL search feature)
# Get your API keys from: https://console.cloud.google.com/
# 1. Create a new project or select an existing one
# 2. Enable YouTube Data API v3
# 3. Create credentials (API key)
# 4. (Optional) Restrict the key to YouTube Data API v3 only
#
# Multiple keys (comma-separated) for automatic rotation:
# YOUTUBE_API_KEY=key1,key2,key3
#
# Or manage keys via Settings page in the web interface (recommended)
YOUTUBE_API_KEY=your_youtube_api_key_here

# ==================== Reddit API Settings ====================
# Reddit API Credentials (required for Reddit search feature)
# Get your credentials from: https://www.reddit.com/prefs/apps
# 1. Click "create app" or "create another app"
# 2. Select "script" as the app type
# 3. Fill in the name and description
# 4. Set redirect uri to: http://localhost:8080
# 5. Click "create app"
# 6. Copy the client ID (under app name) and client secret
#
# User Agent Format: platform:app_id:version (by /u/your_reddit_username)
# Example: linux:ruanlingtools:v1.0 (by /u/yourusername)
#
# Or manage credentials via Settings page in the web interface (recommended)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=platform:app_id:v1.0 (by /u/your_username)

# ==================== Advanced Settings ====================
# Container resource limits (optional, see docker-compose.yml)
# These are already set in docker-compose.yml with good defaults

# Log retention (days)
# Nginx and application logs are rotated automatically
# Max size: 10MB per file, Max files: 3
